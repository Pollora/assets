{
    "name": "pollora/assets",
    "description": "Scripts, styles and Vite builds for WordPress: enqueue an asset with a fluent API, resolve its URL from the Vite manifest or the dev server, per theme, plugin or module. Runs with or without Laravel.",
    "type": "library",
    "keywords": [
        "assets",
        "pollora",
        "vite",
        "wordpress"
    ],
    "homepage": "https://pollora.dev/theming/assets-vite/",
    "license": "MIT",
    "authors": [
        {
            "name": "Amphibee",
            "email": "contact@amphibee.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/Pollora/assets/issues",
        "source": "https://github.com/Pollora/assets"
    },
    "require": {
        "php": "^8.3",
        "pollora/hook": "^2.0.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "antecedent/patchwork": "^2.2",
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.22.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.2",
        "phpstan/phpstan": "^2.1.16",
        "pollora/harness": "^0.1.15",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\Asset\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\Asset\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@phpstan",
            "@lint:check"
        ],
        "test:unit": "pest",
        "test:coverage": "pest --coverage",
        "phpstan": "phpstan analyse",
        "phpstan:ci": "phpstan analyse --no-progress",
        "lint": "pint",
        "lint:check": "pint --test",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
